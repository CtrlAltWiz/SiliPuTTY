<Window x:Class="SillyPutty.HelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SillyPutty Help" Width="650" Height="680" MinWidth="520" MinHeight="450"
 WindowStartupLocation="CenterOwner" Background="#0B1117" Foreground="#E8F1F8" FontFamily="Segoe UI">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,4,14">
   <TextBlock Text="SILLYPUTTY HELP" FontWeight="Bold" FontSize="22" Foreground="#38D996"/>
   <TextBlock Text="Terminal sessions, platform-aware tools, and synchronized file navigation" Foreground="#8495A7" Margin="0,4,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Background="#121B24" CornerRadius="8" Padding="14" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="1. Connect to a session" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20">Choose Local PowerShell, Kali (WSL), or SSH. For SSH, enter a destination such as user@host and select Connect. Kali mode expects a WSL distribution named kali-linux.</TextBlock>
     </StackPanel>
    </Border>
    <Border Background="#121B24" CornerRadius="8" Padding="14" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="2. Platform detection" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20">Auto detects Windows, Linux, or macOS and loads matching commands. Unrecognized devices use Default, intended for switches, routers, firewalls, and appliances. Use the Platform menu to override detection.</TextBlock>
     </StackPanel>
    </Border>
    <Border Background="#121B24" CornerRadius="8" Padding="14" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="3. Terminal and files" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20">Type a command and press Enter or Run. Use Up and Down for command history. In a local session, double-click a folder to change the terminal directory. Double-click a file to open it with its Windows default app. The file list refreshes automatically.</TextBlock>
     </StackPanel>
    </Border>
    <Border Background="#121B24" CornerRadius="8" Padding="14" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="4. Session tools" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20">Click a tool to run its platform-specific command. Tools such as ping, DNS lookup, Nmap, Nikto, and Gobuster require a hostname, IP address, domain, or URL in the Target box. Utilities must already be installed on the selected system.</TextBlock>
     </StackPanel>
    </Border>
    <Border Background="#2B2110" BorderBrush="#7C5A1A" BorderThickness="1" CornerRadius="8" Padding="14">
     <StackPanel><TextBlock Text="Authorized use only" Foreground="#F0B84A" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock Text="Run security and network-testing tools only against systems you own or have explicit permission to test." TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock Text="Tip: hover over a tool button to see the command it runs." Foreground="#8495A7" VerticalAlignment="Center"/>
   <Button Content="Close" DockPanel.Dock="Right" IsDefault="True" IsCancel="True" Click="Close_Click" Background="#176B50" Padding="18,7"/>
  </DockPanel>
 </Grid>
</Window>
