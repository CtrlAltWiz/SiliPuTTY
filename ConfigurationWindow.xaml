<Window x:Class="SiliPuTTY.ConfigurationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SiliPuTTY Configuration" Icon="Assets/siliputty.ico" Width="850" Height="650" MinWidth="720" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="#0B1117" Foreground="#E8F1F8" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#569DE5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#569DE5"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#569DE5"/><Setter Property="Background" Value="#0B1117"/><Setter Property="BorderBrush" Value="#304A60"/><Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#569DE5"/><Setter Property="Background" Value="#0B1117"/><Setter Property="BorderBrush" Value="#304A60"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#569DE5"/><Setter Property="Background" Value="#121B24"/>
  </Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,4,12"><TextBlock Text="CONFIGURATION" FontSize="22" FontWeight="Bold" Foreground="#B038D9"/><TextBlock Text="Settings are saved locally and applied to new sessions." Foreground="#569DE5"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#121B24" CornerRadius="8" Padding="8">
    <TreeView x:Name="CategoryTree" Background="Transparent" Foreground="#569DE5" BorderThickness="0" SelectedItemChanged="CategoryTree_SelectedItemChanged">
     <TreeView.Resources>
      <Style TargetType="TreeViewItem">
       <Setter Property="Foreground" Value="#569DE5"/><Setter Property="Padding" Value="3"/>
       <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#79B9FA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
      </Style>
     </TreeView.Resources>
     <TreeViewItem Header="Session" Tag="Session" IsExpanded="True"><TreeViewItem Header="Saved Sessions" Tag="Saved"/></TreeViewItem>
     <TreeViewItem Header="Logging" Tag="Logging"/>
     <TreeViewItem Header="Terminal" Tag="Terminal"><TreeViewItem Header="Keyboard" Tag="Keyboard"/><TreeViewItem Header="Bell" Tag="Bell"/><TreeViewItem Header="Features" Tag="Features"/></TreeViewItem>
     <TreeViewItem Header="Window" Tag="Window"><TreeViewItem Header="Appearance" Tag="Appearance"/><TreeViewItem Header="Translation" Tag="Translation"/><TreeViewItem Header="Colours" Tag="Colours"/></TreeViewItem>
     <TreeViewItem Header="Connection" Tag="Connection"><TreeViewItem Header="Data" Tag="Data"/><TreeViewItem Header="Proxy" Tag="Proxy"/><TreeViewItem Header="SSH" Tag="SSH"/><TreeViewItem Header="Serial" Tag="Serial"/></TreeViewItem>
     <TreeViewItem Header="Plugins" Tag="Plugins"/>
    </TreeView>
   </Border>
   <Border Grid.Column="2" Background="#121B24" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel"/></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="SaveStatus" Foreground="#38D996" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Save" Click="Save_Click" Background="#176B50" Padding="20,7"/><Button Content="Close" Click="Close_Click" IsCancel="True" Padding="20,7"/></StackPanel></DockPanel>
 </Grid>
</Window>
