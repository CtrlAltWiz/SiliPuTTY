<Window x:Class="SillyPutty.SecretPromptWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Send Secret" Icon="Assets/sillyputty.ico" Width="430" Height="190" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0B1117" Foreground="#E8F1F8">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Enter password or secret" FontSize="17" FontWeight="SemiBold" Foreground="#B038D9"/>
  <PasswordBox x:Name="SecretBox" Grid.Row="1" Margin="0,12,0,0" Padding="8" Background="#070B0F" Foreground="#E8F1F8" KeyDown="SecretBox_KeyDown"/>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="This value is sent directly and is not displayed, logged, or added to history." Foreground="#569DE5" TextWrapping="Wrap" Width="270"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Send" Click="Send_Click" IsDefault="True" Background="#176B50"/><Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/></StackPanel></DockPanel>
 </Grid>
</Window>
