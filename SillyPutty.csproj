<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SillyPutty</AssemblyName>
    <RootNamespace>SillyPutty</RootNamespace>
    <ApplicationIcon>Assets\sillyputty.ico</ApplicationIcon>
    <Version>0.2.0-alpha</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Authors>CtrlAltWiz</Authors>
    <Description>Platform-aware terminal dashboard with network discovery and extensible session tools.</Description>
    <RepositoryUrl>https://github.com/CtrlAltWiz/SillyPutty</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\sillyputty.png" />
    <Resource Include="Assets\sillyputty.ico" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="bin\**\*.cs;obj\**\*.cs;artifacts\**\*.cs" />
    <None Remove="tests\**\*" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
