<Application x:Class="SillyPutty.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#121B24"/>
    <SolidColorBrush x:Key="Panel2" Color="#182633"/>
    <SolidColorBrush x:Key="Accent" Color="#38D996"/>
    <SolidColorBrush x:Key="Muted" Color="#8495A7"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#203243"/><Setter Property="Foreground" Value="#E8F1F8"/>
      <Setter Property="BorderBrush" Value="#304A60"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A465C"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1117"/><Setter Property="Foreground" Value="#DAE7EF"/>
      <Setter Property="BorderBrush" Value="#304A60"/><Setter Property="Padding" Value="8"/>
    </Style>
  </Application.Resources>
</Application>
