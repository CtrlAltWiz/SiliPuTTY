<Window x:Class="SiliPuTTY.NetworkCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SiliPuTTY Network Center" Icon="Assets/siliputty.ico" Width="1000" Height="680" MinWidth="820" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="#0B1117" Foreground="#E8F1F8" FontFamily="Segoe UI" Closing="Window_Closing">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,4,12"><TextBlock Text="NETWORK CENTER" FontSize="22" FontWeight="Bold" Foreground="#B038D9"/><TextBlock Text="Discovery and packet analysis stay separate from terminal sessions to keep the workspace focused." Foreground="#8495A7"/></StackPanel>
  <TabControl Grid.Row="1" Background="#121B24" BorderBrush="#304A60">
   <TabItem Header="Discovery">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel>
      <TextBlock Text="Private /24 network" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="SubnetBox" Width="170" Text="192.168.1.0/24" Margin="0,0,6,0"/>
      <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" Background="#176B50"/>
      <Button x:Name="CancelScanButton" Content="Cancel" Click="CancelScan_Click" IsEnabled="False"/>
      <Button Content="Export CSV" Click="Export_Click"/>
      <ProgressBar x:Name="ScanProgress" Width="150" Height="8" Margin="12,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="254"/>
     </DockPanel>
     <TextBlock Grid.Row="1" x:Name="ScanStatus" Text="Scans are limited to private IPv4 /24 networks. Only scan networks you are authorized to inspect." Foreground="#B038D9" Margin="0,8"/>
     <ListView Grid.Row="2" x:Name="DeviceList" Background="#0B1117" Foreground="#569DE5" BorderThickness="0" ItemsSource="{Binding Devices}">
      <ListView.View><GridView><GridViewColumn Header="IP Address" Width="125" DisplayMemberBinding="{Binding Address}"/><GridViewColumn Header="Hostname" Width="190" DisplayMemberBinding="{Binding Hostname}"/><GridViewColumn Header="MAC Address" Width="145" DisplayMemberBinding="{Binding Mac}"/><GridViewColumn Header="Open services" Width="250" DisplayMemberBinding="{Binding Services}"/><GridViewColumn Header="Latency" Width="90" DisplayMemberBinding="{Binding Latency}"/></GridView></ListView.View>
     </ListView>
     <TextBlock Grid.Row="3" Text="Discovery uses ICMP plus brief checks for SSH, HTTP/S, SMB, RDP, and WinRM. MAC addresses are read from the local ARP cache." Foreground="#8495A7" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
   </TabItem>
   <TabItem Header="Packet Capture">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel>
      <TextBlock Text="Interface" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox x:Name="InterfaceBox" Width="270" Margin="0,0,8,0"/>
      <TextBlock Text="Capture filter" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="CaptureFilterBox" Width="210" ToolTip="BPF capture filter, e.g. host 192.168.1.10 or port 53"/>
      <TextBlock Text="Seconds" VerticalAlignment="Center" Margin="8,0,5,0"/><TextBox x:Name="CaptureDurationBox" Width="60" Text="300" ToolTip="Automatic graceful stop, 10–86400 seconds"/>
      <Button x:Name="StartCaptureButton" Content="Start" Click="StartCapture_Click" Background="#176B50"/><Button x:Name="StopCaptureButton" Content="Stop" Click="StopCapture_Click" IsEnabled="False"/>
     </WrapPanel>
     <DockPanel Grid.Row="1" Margin="0,8"><TextBlock x:Name="CaptureStatus" Foreground="#B038D9" VerticalAlignment="Center"/><Button Content="Open PCAP…" Click="OpenPcap_Click" DockPanel.Dock="Right"/></DockPanel>
     <TextBox Grid.Row="2" x:Name="PacketOutput" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#070B0F" Foreground="#569DE5" BorderThickness="0" FontFamily="Cascadia Mono,Consolas" FontSize="12"/>
     <TextBlock Grid.Row="3" Text="Capture filters use BPF syntax. The duration limit lets TShark close PCAPNG files gracefully. Display filters are applied when opening a saved capture in Wireshark. Capturing may require Npcap and administrator privileges." Foreground="#8495A7" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
   </TabItem>
   <TabItem Header="Capabilities">
    <StackPanel Margin="18"><TextBlock Text="BACKEND STATUS" FontSize="18" FontWeight="SemiBold" Foreground="#B038D9"/><TextBlock x:Name="CapabilityText" Foreground="#569DE5" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"/><Border x:Name="RecommendationPanel" Background="#211229" BorderBrush="#B038D9" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock x:Name="RecommendationText" Foreground="#B038D9" TextWrapping="Wrap" LineHeight="21"/></Border><Button Content="Refresh detection" Click="RefreshCapabilities_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
